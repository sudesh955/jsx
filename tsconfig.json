{
  "compilerOptions": {
    "rootDir": "./src",

    "target": "ESNext",
    "outDir": "./dist",
    "module": "esnext",
    "declaration": true,
    "rewriteRelativeImportExtensions": true,

    "lib": ["ESNext"],
    "moduleResolution": "bundler",

    "strict": true,
    "skipLibCheck": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,

    "jsx": "react-jsx",
    "jsxImportSource": "."
  },
  "exclude": ["dist"]
}
